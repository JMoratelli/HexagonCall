# Bancada do Hexagon Call contra um PBX de verdade. Copie para .env (fica fora
# do git: so na maquina de quem testa) e preencha. A senha fica aqui, entao:
# chmod 600 .env
SIP_USUARIO=1001
SIP_DOMINIO=pbx.exemplo.com.br
SIP_NOME=
SIP_SENHA=
# Para onde a bancada liga, manda mensagem e olha a presenca quando nao se diz.
SIP_DESTINO=1002
